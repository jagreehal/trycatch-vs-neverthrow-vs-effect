{
  "name": "trycatch-vs-neverthrow-vs-effect",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run src --exclude 'src/___temp___/**'",
    "test:watch": "vitest src -w --exclude 'src/___temp___/**'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "effect-tsgo patch",
    "analyze:awaitly": "awaitly-analyze src/workflow-version.test.ts --no-types --format=mermaid",
    "analyze:effect": "effect-analyze src/effect-version.test.ts",
    "analyze:explain": "effect-analyze src/effect-version.test.ts --format explain",
    "analyze:audit": "effect-analyze src --coverage-audit --quiet",
    "analyze:errors": "effect-analyze src --error-channel",
    "analyze:lint": "effect-analyze src --lint-source",
    "analyze:check": "awaitly-analyze src/comparison/data-pipeline.test.ts --no-types --assert-diagrammable"
  },
  "keywords": [
    "typescript",
    "error-handling",
    "functional-programming"
  ],
  "author": "Jag Reehal",
  "license": "ISC",
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "awaitly-analyze": "0.31.2",
    "effect-analyzer": "3.6.0",
    "eslint-plugin-awaitly": "^4.1.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "awaitly": "^6.2.0",
    "effect": "4.0.0-rc.112",
    "neverthrow": "^8.2.0",
    "zod": "^4.6.5"
  }
}
